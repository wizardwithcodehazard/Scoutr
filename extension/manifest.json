{
  "manifest_version": 3,
  "name": "Scoutr",
  "version": "2.0.0",
  "description": "In-browser companion for autonomous startup job applications and form filling, powered by Bright Data Scraper Studio and Gemini AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "96": "icon96.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "96": "icon96.png"
  }
}
