{
  "manifest_version": 3,
  "name": "n8n AI Form Filler",
  "version": "0.1",
  "description": "Uses a local n8n workflow and AI to fill forms.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5678/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}